[Unit]
Description=Apura BU (gunicorn)
After=network.target

[Service]
User=apura
Group=www-data
WorkingDirectory=/srv/apura_bu/servidor
EnvironmentFile=/srv/apura_bu/servidor/.env
ExecStart=/srv/apura_bu/venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8010 --workers 3 --timeout 60 --access-logfile -
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
